# Application
APP_NAME=Underwriting Intelligence Agent
APP_ENV=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database (PostgreSQL 16 + pgvector). Host port 5433 avoids a local Postgres on 5432.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/underwriting_agent

# Embeddings stay on the 256-dimension pgvector column.
# Do not point EMBEDDING_MODEL at text-embedding-3-small or text-embedding-3-large.
# auto uses OpenAI embeddings at 256 dimensions when OPENAI_API_KEY is set, then xAI, then a local hash.
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=v1
EMBEDDING_DIMENSIONS=256
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chunking. A section shorter than the window stays one chunk. Overlap is the
# characters repeated on the next window. Set CHUNK_BOUNDARY_MARGIN=0 for an exact character cut.
CHUNK_WINDOW_SIZE=900
CHUNK_OVERLAP=150
CHUNK_BOUNDARY_MARGIN=40
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
# Judge for retrieved-document evals only. Not the investigation chat model.
XAI_EVAL_MODEL=grok-4.7
RETRIEVAL_SEMANTIC_WEIGHT=0.7
RETRIEVAL_LEXICAL_WEIGHT=0.3

# Agent completions. OpenAI only. This does not select the embedding model.
# gpt-5.6-sol reasoning effort defaults to medium. gpt-5.4-mini defaults to none.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-sol
LLM_SPECIALIST_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
INVESTIGATION_AGENT_ENABLED=false

# MLflow. Host port 5001 because macOS AirPlay uses 5000.
# Inside Compose the API overrides this to http://mlflow:5000.
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_EXPERIMENT=underwriting-intelligence-agent
MLFLOW_TRACING_ENABLED=true

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=underwriting-intelligence-agent
